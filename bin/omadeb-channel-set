#!/bin/bash

# omadeb:summary=Set the Omadeb channel, which dictates what git branch and package repository is used.
# omadeb:args=<stable|dev>
# omadeb:requires-sudo=true

if (($# == 0)); then
  echo "Usage: omadeb-channel-set [stable|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") omadeb-branch-set "main" && omadeb-refresh-apt "stable" ;;
"dev") omadeb-branch-set "dev" && omadeb-refresh-apt "dev" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac