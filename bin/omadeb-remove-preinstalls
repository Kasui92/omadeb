#!/bin/bash

# omadeb:summary=Remove preinstalled Omadeb applications (web apps, TUIs, and selected packages).

if gum confirm "Are you sure you want to remove all preinstalled web apps, TUI wrappers, and desktop applications?"; then
  echo -e "Removing preinstalled Omadeb applications...\n"

  omadeb-webapp-remove-all
  omadeb-tui-remove-all

  # Remove npm stubs
  rm -f ~/.local/bin/codex ~/.local/bin/gemini ~/.local/bin/copilot ~/.local/bin/claude \
       ~/.local/bin/opencode ~/.local/bin/playwright-cli ~/.local/bin/pi

  omadeb-pkg-drop \
    spotify \
    libreoffice \
    xournalpp \
    pinta \
    lazydocker
fi