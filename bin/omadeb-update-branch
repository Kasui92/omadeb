#!/bin/bash

# omadeb:summary=Switch Omadeb branches and update from the selected branch.
# omadeb:args=<branch>

set -e

if (($# == 0)); then
  echo "Usage: omadeb-branch-set [master|dev]"
  exit 1
fi

branch="$1"

if ! git -C "$OMADEB_PATH" diff --quiet || ! git -C "$OMADEB_PATH" diff --cached --quiet; then
  stashed=true
  git -C "$OMADEB_PATH" stash push -u -m "Autostash before switching to $branch"
else
  stashed=false
fi

# Switch branches
git -C "$OMADEB_PATH" switch "$branch"

# Reapply stash if we made one
if [[ $stashed == true ]]; then
  if ! git -C "$OMADEB_PATH" stash pop; then
    echo "⚠️ Conflicts when applying stash — stash kept"
  fi
fi

# Update the system from the new branch
omadeb-update-perform
