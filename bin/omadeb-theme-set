#!/bin/bash

# omadeb:summary=Apply an Omadeb theme.
# omadeb:args=<theme-name>
# omadeb:examples=omadeb theme list | omadeb theme set "Tokyo Night"

if [[ -z $1 ]]; then
  echo "Usage: omadeb-theme-set <theme-name>" >&2
  exit 1
fi

CURRENT_THEME_PATH="$HOME/.config/omadeb/current/theme"
NEXT_THEME_PATH="$HOME/.config/omadeb/current/next-theme"
USER_THEMES_PATH="$HOME/.config/omadeb/themes"
OMADEB_THEMES_PATH="$OMADEB_PATH/themes"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Check if the theme entered exists
if [[ ! -d $OMADEB_THEMES_PATH/$THEME_NAME ]] && [[ ! -d $USER_THEMES_PATH/$THEME_NAME ]]; then
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

# Setup clean next theme directory (for atomic theme config swapping)
rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Copy official theme first, then overlay user customizations on top
cp -r "$OMADEB_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null
cp -r "$USER_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null

# Generate colors.toml from alacritty.toml if theme is missing colors.toml
if [[ ! -f $NEXT_THEME_PATH/colors.toml && -f $NEXT_THEME_PATH/alacritty.toml ]]; then
  omadeb-theme-colors-from-alacritty "$NEXT_THEME_PATH"
fi

# Generate dynamic configs
omadeb-theme-set-templates

# Swap next theme in as current
rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

# Store theme name for reference
echo "$THEME_NAME" > "$HOME/.config/omadeb/current/theme.name"

# Change background with theme
if [[ $OMADEB_THEME_SKIP_BACKGROUND != "1" ]]; then
  omadeb-theme-bg-next
fi

# Restart components to apply new theme
omadeb-restart-btop
omadeb-restart-terminal
omadeb-restart-zellij
omadeb-restart-opencode

# Change app specific themes
omadeb-theme-set-gnome
omadeb-theme-set-gnome-extensions
omadeb-theme-set-vscode
omadeb-theme-set-obsidian

# Call hook on theme set
omadeb-hook theme-set "$THEME_NAME" >/dev/null