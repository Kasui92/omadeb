#!/bin/bash

# omadeb:summary=Set the current background image.
# omadeb:args=<path-to-image> [zoom|center|stretch|fill|fit|spanned]
# omadeb:examples=omadeb theme bg set ~/Pictures/background.png

if [[ -z $1 ]]; then
  echo "Usage: omadeb-theme-bg-set <path-to-image> [zoom|center|stretch|fill|fit|spanned]" >&2
  exit 1
fi

BACKGROUND=${1:-'file:///usr/share/desktop-base/active-theme/wallpaper/contents/images/1920x1080.svg'}
ZOOM_FLAG=${2:-'zoom'}

CURRENT_BACKGROUND_LINK="$HOME/.config/omadeb/current/background"

# Create symlink to the new background
ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

gsettings set org.gnome.desktop.background picture-uri $CURRENT_BACKGROUND_LINK
gsettings set org.gnome.desktop.background picture-uri-dark $CURRENT_BACKGROUND_LINK
gsettings set org.gnome.desktop.background picture-options $ZOOM_FLAG
